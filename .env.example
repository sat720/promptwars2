# VoteWise AI Environment Variables Example
# Copy this to .env.local for local development
# NEVER commit .env.local to Git

# Gemini AI API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud API Key (Translate + TTS + Maps)
NEXT_PUBLIC_GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Google Maps JavaScript API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# App Configuration (optional)
NEXT_PUBLIC_APP_NAME=VoteWise AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
